generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum DocumentType {
  COURSE_MATERIAL
  CERTIFICATE
  OTHER
}

enum DocumentStorageProvider {
  LOCAL
  S3
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String?
  name                    String?
  nickname                String?
  bio                     String?
  image                   String?
  studentId               String?                  @unique
  emailVerified           DateTime?
  isPlatformAdmin         Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMember[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  enrollments             Enrollment[]
  certificates            Certificate[]
  instructedCourses       Course[]
  submittedAssignments    AssignmentSubmission[]   @relation("SubmittedBy")
  gradedAssignments       AssignmentSubmission[]   @relation("GradedBy")
  examAttempts            ExamAttempt[]

  @@index([email])
  @@index([studentId])
  @@index([isPlatformAdmin])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model LoginThrottle {
  id            String    @id @default(cuid())
  email         String    @unique
  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastFailedAt  DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  courses   Course[]
  documents Document[]
  auditLogs AuditLog[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole     @default(STUDENT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]   @relation("AuditActorMember")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([userId])
}

model Course {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  slug           String       @unique
  description    String?
  imageUrl       String?
  instructorId   String
  pricing        Decimal      @db.Decimal(12, 2)
  currency       String       @default("NGN")
  isPublished    Boolean      @default(false)
  capacity       Int?
  startDate      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor     User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  modules        Module[]
  enrollments    Enrollment[]

  @@index([organizationId])
  @@index([instructorId])
  @@index([isPublished])
}

// A Module is a course "week" — content is authored ahead of time but
// hidden from students until isPublished is flipped on. Once published it
// stays visible forever (self-paced), it is never re-hidden.
model Module {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  order       Int
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]
  exams       Exam[]

  @@unique([courseId, order])
  @@index([courseId])
  @@index([courseId, isPublished])
}

model Lesson {
  id           String            @id @default(cuid())
  moduleId     String
  title        String
  content      String?
  videoUrl     String?
  order        Int
  durationMins Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  module       Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     StudentProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Enrollment {
  id            String            @id @default(cuid())
  userId        String
  courseId      String
  status        EnrollmentStatus  @default(PENDING)
  paymentStatus PaymentStatus     @default(PENDING)
  enrolledAt    DateTime          @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress      StudentProgress[]
  payment       Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([paymentStatus])
}

model StudentProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime?
  score        Int?
  attempt      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

enum AssignmentType {
  ASSIGNMENT
  CLASSWORK
}

model Assignment {
  id           String                 @id @default(cuid())
  moduleId     String
  type         AssignmentType         @default(ASSIGNMENT)
  title        String
  instructions String
  dueDate      DateTime?
  maxScore     Int                    @default(100)
  order        Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  module       Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  content      String?
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation("SubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy     User?      @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

model Exam {
  id           String         @id @default(cuid())
  moduleId     String
  title        String
  instructions String?
  passingScore Int            @default(70)
  order        Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  module       Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    ExamQuestion[]
  attempts     ExamAttempt[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model ExamQuestion {
  id        String       @id @default(cuid())
  examId    String
  question  String
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  exam      Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options   ExamOption[]
  answers   ExamAnswer[]

  @@unique([examId, order])
  @@index([examId])
}

model ExamOption {
  id         String       @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean      @default(false)
  order      Int
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    ExamAnswer[]

  @@index([questionId])
}

model ExamAttempt {
  id          String       @id @default(cuid())
  examId      String
  userId      String
  score       Int
  passed      Boolean
  submittedAt DateTime     @default(now())
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     ExamAnswer[]

  @@index([examId])
  @@index([userId])
}

model ExamAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  attempt          ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   ExamOption   @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Payment {
  id           String        @id @default(cuid())
  enrollmentId String        @unique
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("NGN")
  provider     String?
  providerRef  String?
  status       PaymentStatus @default(PENDING)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([status])
  @@index([providerRef])
}

model Certificate {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  credentialId String   @unique
  issuedAt     DateTime @default(now())
  pdfUrl       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([credentialId])
}

model Document {
  id              String                  @id @default(cuid())
  organizationId  String
  name            String
  category        DocumentType            @default(OTHER)
  storageProvider DocumentStorageProvider @default(LOCAL)
  storageKey      String
  bucket          String?
  contentType     String?
  sizeBytes       Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storageKey])
  @@index([organizationId])
  @@index([organizationId, category])
}

model AuditLog {
  id             String              @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorMemberId  String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMember    OrganizationMember? @relation("AuditActorMember", fields: [actorMemberId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId])
  @@index([actorMemberId])
  @@index([createdAt])
}
