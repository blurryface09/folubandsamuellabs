generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum DocumentType {
  COURSE_MATERIAL
  CERTIFICATE
  OTHER
}

enum DocumentStorageProvider {
  LOCAL
  S3
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String?
  name                    String?
  nickname                String?
  bio                     String?
  image                   String?
  studentId               String?                  @unique @default(cuid())
  emailVerified           DateTime?
  isPlatformAdmin         Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMember[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  enrollments             Enrollment[]
  certificates            Certificate[]
  instructedCourses       Course[]

  @@index([email])
  @@index([studentId])
  @@index([isPlatformAdmin])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model LoginThrottle {
  id            String    @id @default(cuid())
  email         String    @unique
  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastFailedAt  DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([lockedUntil])
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       OrganizationMember[]
  courses       Course[]
  documents     Document[]
  auditLogs     AuditLog[]

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           UserRole         @default(STUDENT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]       @relation("AuditActorMember")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([userId])
}

model Course {
  id            String         @id @default(cuid())
  organizationId String
  title         String
  slug          String         @unique
  description   String?
  imageUrl      String?
  instructorId  String
  pricing       Decimal        @db.Decimal(12, 2)
  currency      String         @default("NGN")
  isPublished   Boolean        @default(false)
  capacity      Int?
  startDate     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor    User           @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  modules       Module[]
  enrollments   Enrollment[]

  @@index([organizationId])
  @@index([instructorId])
  @@index([isPublished])
}

model Module {
  id        String    @id @default(cuid())
  courseId  String
  title     String
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@unique([courseId, order])
}

model Lesson {
  id            String            @id @default(cuid())
  moduleId      String
  title         String
  content       String?
  videoUrl      String?
  order         Int
  durationMins  Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  module        Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      StudentProgress[]

  @@index([moduleId])
  @@unique([moduleId, order])
}

model Enrollment {
  id             String             @id @default(cuid())
  userId         String
  courseId       String
  status         EnrollmentStatus   @default(PENDING)
  paymentStatus  PaymentStatus      @default(PENDING)
  enrolledAt     DateTime           @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress       StudentProgress[]
  payment        Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([paymentStatus])
}

model StudentProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime?
  score        Int?
  attempt      Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
}

model Payment {
  id              String        @id @default(cuid())
  enrollmentId    String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("NGN")
  provider        String?
  providerRef     String?
  status          PaymentStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([status])
  @@index([providerRef])
}

model Certificate {
  id           String    @id @default(cuid())
  userId       String
  courseId     String
  credentialId String    @unique
  issuedAt     DateTime  @default(now())
  pdfUrl       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([credentialId])
}

model Document {
  id                String                  @id @default(cuid())
  organizationId    String
  name              String
  category          DocumentType            @default(OTHER)
  storageProvider   DocumentStorageProvider @default(LOCAL)
  storageKey        String
  bucket            String?
  contentType       String?
  sizeBytes         Int?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storageKey])
  @@index([organizationId])
  @@index([organizationId, category])
}

model AuditLog {
  id             String              @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorMemberId  String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorMember    OrganizationMember? @relation("AuditActorMember", fields: [actorMemberId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@index([organizationId])
  @@index([organizationId, action])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId])
  @@index([actorMemberId])
  @@index([createdAt])
}
